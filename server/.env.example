# CivicEye Server environment
# Copy to .env and adjust values. Never commit the real .env file.

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/civiceye

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Demo mode seeds demo accounts & data. Keep true for local development.
DEMO_MODE=true

# AI provider: "heuristic" (offline, always works) | "openai" | "gemini"
AI_PROVIDER=heuristic

# Used only when AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Used only when AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Storage: "local" (dev) | "s3"
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Reverse geocoding (OSM Nominatim). Disable offline.
NOMINATIM_ENABLED=true

# Optional logging of SQL queries
DB_LOGGING=false

# Rate limiting defaults
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=600
